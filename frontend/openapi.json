{
  "openapi": "3.1.0",
  "info": {
    "title": "eInvoice API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health Check",
        "description": "Return service health, including whether KoSIT validation is ready.",
        "operationId": "health_check_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/invoices/parse": {
      "post": {
        "tags": [
          "invoices"
        ],
        "summary": "Parse Invoice",
        "description": "Accept an XRechnung XML or ZUGFeRD PDF and return a structured parse result.",
        "operationId": "parse_invoice_api_invoices_parse_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_parse_invoice_api_invoices_parse_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceParseResponse-Output"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/invoices/export/mapping": {
      "get": {
        "tags": [
          "export"
        ],
        "summary": "Export Mapping Docs",
        "description": "Document DTO → export column mapping for Steuerberater.",
        "operationId": "export_mapping_docs_api_invoices_export_mapping_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ExportMappingDoc"
                  },
                  "type": "array",
                  "title": "Response Export Mapping Docs Api Invoices Export Mapping Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/invoices/export": {
      "post": {
        "tags": [
          "export"
        ],
        "summary": "Export Invoice",
        "description": "Export a previously parsed invoice DTO as CSV, Excel, or DATEV CSV.",
        "operationId": "export_invoice_api_invoices_export_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/invoices/export/validation-report": {
      "post": {
        "tags": [
          "export"
        ],
        "summary": "Export Validation Report",
        "description": "Download a German plain-text validation report for supplier or Steuerberater.\nAllowed even when the invoice is invalid — that is the intended use.",
        "operationId": "export_validation_report_api_invoices_export_validation_report_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidationReportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/invoices/export/accountant-package": {
      "post": {
        "tags": [
          "export"
        ],
        "summary": "Export Accountant Package",
        "description": "ZIP for Steuerberater: original XML/PDF + summary + Prüfbericht + Excel + DATEV.",
        "operationId": "export_accountant_package_api_invoices_export_accountant_package_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountantPackageRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
