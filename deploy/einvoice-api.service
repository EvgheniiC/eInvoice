[Unit]
Description=eInvoice FastAPI backend (uvicorn)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/eInvoice/backend
Environment=PATH=/opt/eInvoice/backend/.venv/bin
Environment=LOG_LEVEL=INFO
Environment=ENVIRONMENT=production
EnvironmentFile=-/opt/eInvoice/backend/.env
# stdout/stderr → journald (invoice bodies are never logged by the app)
StandardOutput=journal
StandardError=journal
ExecStart=/opt/eInvoice/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=3
TimeoutStopSec=15

# Process isolation for the API and the KoSIT Java child
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
MemoryMax=1G
TasksMax=64
LimitCORE=0

[Install]
WantedBy=multi-user.target
